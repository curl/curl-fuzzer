# The completion and NOOP replies share one queued fragment. Curl retains the
# second response in pingpong overflow storage, so ftp_done's blocking
# postquote path can consume it without a peer thread or a wall-clock wait.
scheme: SCHEME_FTP
host_path: "ftp.test/postquote.bin"
ftp_postquote: "NOOP"
connection {
  initial_response: "220 ready\r\n"
  on_readable: "331 password required\r\n"
  on_readable: "230 logged in\r\n"
  on_readable: "257 \"/\" is current directory\r\n"
  on_readable: "229 Entering Extended Passive Mode (|||1025|)\r\n"
  on_readable: "200 binary type selected\r\n"
  on_readable: "213 4\r\n"
  on_readable: "150 opening data\r\n"
  on_readable: "226 transfer complete\r\n200 postquote accepted\r\n"
}
subsequent_connections { initial_response: "body" }
