# Complete implicit-TLS download: verified control handshake, login, PBSZ/PROT
# data-channel protection negotiation, PWD, EPSV, TYPE, SIZE, RETR over a
# second verified TLS connection, then the final control-channel completion.
scheme: SCHEME_FTPS
host_path: "tls.test/file.bin"
options { option_id: CURLOPT_USERNAME string_value: "fuzz" }
options { option_id: CURLOPT_PASSWORD string_value: "secret" }
connection {
  initial_response: "220 ftps fuzz peer ready\r\n"
  on_readable: "331 password required\r\n"
  on_readable: "230 logged in\r\n"
  on_readable: "200 PBSZ accepted\r\n"
  on_readable: "200 PROT accepted\r\n"
  on_readable: "257 \"/\" is current directory\r\n"
  on_readable: "229 Entering Extended Passive Mode (|||12345|)\r\n"
  on_readable: "200 type set\r\n"
  on_readable: "213 15\r\n"
  on_readable: "150 opening secure data connection\r\n"
  # Exercise the peer's bounded repair of an otherwise complete final reply.
  on_readable: "226 transfer complete"
}
subsequent_connections { initial_response: "secret over tls" }
