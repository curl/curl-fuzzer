# Reject EPRT after curl opens its active listener, then accept the IPv4 PORT
# retry and complete the download over the replacement listener.
scheme: SCHEME_FTP
host_path: "ftp.test/eprt-port-fallback.bin"
options { option_id: CURLOPT_FTPPORT string_value: "127.0.0.1" }
options { option_id: CURLOPT_FTP_USE_EPRT bool_value: true }
connection {
  initial_response: "220 ready\r\n"
  on_readable: "331 password required\r\n"
  on_readable: "230 logged in\r\n"
  on_readable: "257 \"/\" is current directory\r\n"
  on_readable: "500 EPRT unsupported\r\n"
  on_readable: "200 PORT accepted\r\n"
  on_readable: "200 type set\r\n"
  on_readable: "213 15\r\n"
  on_readable: "150 opening data\r\n"
  on_readable: "226 complete\r\n"
}
subsequent_connections { initial_response: "active-fallback" }
