# Rejecting PROT after a successful implicit-TLS control handshake and login
# reaches curl's data-channel TLS policy error before any passive socket opens.
scheme: SCHEME_FTPS
host_path: "tls.test/protected.bin"
options { username: "fuzz" }
options { password: "secret" }
connection {
  initial_response: "220 ftps fuzz peer ready\r\n"
  on_readable: "331 password required\r\n"
  on_readable: "230 logged in\r\n"
  on_readable: "200 PBSZ accepted\r\n"
  on_readable: "500 PROT unsupported\r\n"
}
