# Force the active-mode listener filter allocation to fail after curl has
# opened, bound, listened on, and announced the harness-owned loopback socket.
# This build-specific ordinal exercises the raw listener cleanup path.
scheme: SCHEME_FTP
host_path: "ftp.test/active-listener-allocation-failure"
options { ftpport: "127.0.0.1" }
connection {
  initial_response: "220 ready\r\n"
  on_readable: "331 password required\r\n"
  on_readable: "230 logged in\r\n"
  on_readable: "257 \"/\" is current directory\r\n"
}
subsequent_connections {}
fail_allocations: 86
