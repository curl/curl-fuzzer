# Fill the CONNECT socket, then combine repeated public multi-poll calls with
# the policy-owned 2048/48 backpressure so the live HAProxy setup filter can be
# observed while its fixed IPv6 v1 line is pending. Backpressure stays out of
# this mutation input because the closed CONNECT+HAProxy selector supplies it.
scheme: SCHEME_HTTP
host_path: "transport.test/haproxy-poll"
http_transport_mode: HTTP_TRANSPORT_CONNECT_PROXY
haproxy_protocol: true
probe_multi_pollset: true
request_headers: "X-Haproxy-Pad-1: "
connection {
  # Keep the CONNECT and origin replies in separate bounded script entries,
  # with an explicit empty peer-service boundary between them.
  initial_response: "HTTP/1.1 200 Connection Established\r\nProxy-Agent: proto-fuzzer\r\n\r\n"
  on_readable: ""
  on_readable: "HTTP/1.1 200 OK\r\nContent-Length: 7\r\nConnection: close\r\n\r\nproxied"
}
