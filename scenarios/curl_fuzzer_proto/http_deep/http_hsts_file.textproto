# Parse persisted HSTS entries, including subdomain and unlimited-expiry
# forms. Hosts deliberately do not match this request: response-header seeds
# cover upgrade behavior, while this one retains a complete plaintext transfer
# after exercising the separate cache-file grammar.
scheme: SCHEME_HTTP
host_path: "hsts-file.test/cache"
options { option_id: CURLOPT_HSTS_CTRL uint_value: 1 }
hsts_file: ".other.test \"20351231 23:59:59\"\nunlimited.test \"unlimited\"\n"
connection {
  initial_response: "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n"
}
