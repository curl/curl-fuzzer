# OpenSSL accepts this harness-owned close_notify before negotiation completes,
# so curl translates SSL_ERROR_ZERO_RETURN without reaching HTTP. Other client
# backends treat the profile as DEFAULT and complete the ordinary response.
scheme: SCHEME_HTTPS
host_path: "tls.test/openssl-close-notify"
tls_handshake_profile: TLS_HANDSHAKE_OPENSSL_CLOSE_NOTIFY
trace_config: "all"
connection {
  initial_response: "HTTP/1.1 200 OK\r\nContent-Length: 11\r\n\r\nunreachable"
}
