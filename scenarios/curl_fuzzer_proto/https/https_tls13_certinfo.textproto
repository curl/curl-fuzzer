# The dedicated HTTPS target turns this plaintext script into TLS records.
# Default negotiation selects TLS 1.3, while CERTINFO makes curl retain and
# format the verified peer chain for its post-transfer result probe.
scheme: SCHEME_HTTPS
host_path: "tls.test/tls13-certinfo"
options { ssl_verifypeer: true }
options { ssl_verifyhost: 2 }
options { certinfo: true }
options { ssl_sessionid_cache: true }
connection {
  initial_response: "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 5\r\n\r\ntls13"
}
