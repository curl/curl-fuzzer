# Exercise the clear session-key import route with a fresh TLS 1.3 cache.
scheme: SCHEME_HTTPS
host_path: "tls.test/fresh-session-key"
tls_session_cache_profile: TLS_SESSION_CACHE_FRESH_SESSION_KEY
options { ssl_sessionid_cache: true }
options { sslversion: 458759 }
connection {
  initial_response: "HTTP/1.1 200 OK\r\nContent-Length: 6\r\n\r\nreplay"
}
