# Feed OpenSSL one fixed pre-handshake HelloRequest record so its message
# callback classifies handshake type zero. Other TLS backends use the default
# peer and complete the ordinary response.
scheme: SCHEME_HTTPS
host_path: "tls.test/openssl-hello-request"
tls_handshake_profile: TLS_HANDSHAKE_OPENSSL_HELLO_REQUEST
trace_config: "all"
# HelloRequest is a pre-TLS-1.3 handshake type. Pin the client to TLS 1.2 so
# OpenSSL classifies the fixed record before rejecting the incomplete exchange.
options { sslversion: 393222 }
connection {
  initial_response: "HTTP/1.1 200 OK\r\nContent-Length: 11\r\n\r\nunreachable"
}
