# The first connection receives a TLS 1.3 ticket advertising bounded 0-RTT.
# Closing the redirect socket makes curl resume that session for the same host
# and send the second GET as early data. The peer deliberately rejects 0-RTT,
# so curl must replay the request after the handshake to receive this response.
scheme: SCHEME_HTTPS
host_path: "tls.test/early-data"
options { followlocation: 1 }
options { maxredirs: 2 }
options { ssl_sessionid_cache: true }
options { sslversion: 458759 }
options { ssl_options: 64 }
connection {
  initial_response: "HTTP/1.1 302 Found\r\nLocation: https://tls.test/final\r\nConnection: close\r\nContent-Length: 0\r\n\r\n"
}
subsequent_connections {
  initial_response: "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nearly"
}
