# An invalid CRAM-MD5 challenge makes curl cancel that exchange, then select
# PLAIN from the remaining advertised mechanisms before RETR.
scheme: SCHEME_POP3
host_path: "pop3.test/1"
options { username: "fuzz" }
options { password: "secret" }
connection {
  initial_response: "+OK pop3.test ready\r\n"
  on_readable: "+OK capabilities\r\nSASL CRAM-MD5 PLAIN\r\nUSER\r\n.\r\n"
  on_readable: "+ !\r\n"
  on_readable: "-ERR authentication exchange cancelled\r\n"
  on_readable: "+ \r\n"
  on_readable: "+OK authentication succeeded\r\n"
  on_readable: "+OK 17 octets\r\nHello from POP3\r\n.\r\n"
}
