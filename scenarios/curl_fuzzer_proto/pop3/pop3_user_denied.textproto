# A -ERR to USER must fail the POP3 transfer during authentication instead of
# reaching PASS or RETR.
scheme: SCHEME_POP3
host_path: "pop3.test/1"
options { option_id: CURLOPT_USERNAME string_value: "fuzz" }
options { option_id: CURLOPT_PASSWORD string_value: "wrong" }
connection {
  initial_response: "+OK pop3.test ready\r\n"
  on_readable: "+OK capabilities\r\nUSER\r\n.\r\n"
  on_readable: "-ERR no such user\r\n"
}
