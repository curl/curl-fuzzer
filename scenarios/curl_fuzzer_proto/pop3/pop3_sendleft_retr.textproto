# A receive-buffer-only pressure setup makes this long RETR command short-write
# before the immediate-service peer drains it, exercising POP3's send-left path.
scheme: SCHEME_POP3
host_path: "pop3."
options { username: "fuzz" }
options { password: "secret" }
connection {
  initial_response: "+OK pop3.test ready\r\n"
  on_readable: "+OK capabilities\r\nUSER\r\n.\r\n"
  on_readable: "+OK user accepted\r\n"
  on_readable: "+OK pass accepted\r\n"
  on_readable: "+OK 17 octets\r\nHello from POP3\r\n.\r\n"
  backpressure { recv_buf_bytes: 2048 }
}
