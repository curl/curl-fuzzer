# Advertise a mechanism deliberately unavailable in this build. Curl must
# reject authentication without sending an AUTH line.
scheme: SCHEME_POP3
host_path: "pop3.test/1"
options { username: "fuzz" }
options { password: "secret" }
options { login_options: "AUTH=NTLM" }
connection {
  initial_response: "+OK pop3.test ready\r\n"
  on_readable: "+OK capabilities\r\nSASL NTLM\r\nUSER\r\n.\r\n"
}
