# Cover resume handling in file_upload while the destination remains a
# harness-owned anonymous descriptor. Curl skips the first four upload bytes,
# then writes the rest through its bounded callback loop.
scheme: SCHEME_FILE
file_source: "sink"
upload {
  data: "skip-and-upload"
  read_sizes: 2
  read_sizes: 7
  terminal: UPLOAD_TERMINAL_EOF
}
options { upload: true }
options { resume_from_large: 4 }
options { infilesize_large: 15 }
