# Exercise file.c's synchronous upload path against a harness-owned anonymous
# descriptor. No mutation-controlled pathname is accepted.
scheme: SCHEME_FILE
file_source: "sink"
upload {
  data: "file upload payload\n"
  read_sizes: 3
  read_sizes: 5
  terminal: UPLOAD_TERMINAL_EOF
}
options { upload: true }
options { infilesize_large: 20 }
options { upload_buffersize: 16384 }
