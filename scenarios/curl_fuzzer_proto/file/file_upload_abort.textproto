# Drive file_upload's client-read error path after one bounded payload chunk.
# Target policy replaces the mutation-controlled path with the /dev/null sink
# before curl can open it.
scheme: SCHEME_FILE
host_path: "localhost/not-an-output-file"
upload {
  data: "partial"
  read_sizes: 7
  terminal: UPLOAD_TERMINAL_ABORT
}
options { option_id: CURLOPT_UPLOAD bool_value: true }
options { option_id: CURLOPT_INFILESIZE_LARGE uint_value: 8 }
