# Exercise curl's local-file range, header, and conversion controls against the
# fixed empty target. RANGE is parsed by file.c even though /dev/null is empty.
scheme: SCHEME_FILE
host_path: "localhost/dev/null"
options { header: true }
options { range: "0-0" }
options { transfertext: true }
options { crlf: true }
options { buffersize: 4096 }
