# Exercise the file protocol's time-condition and resume selectors. Both are
# evaluated locally after the policy replaces the path with /dev/null.
scheme: SCHEME_FILE
host_path: "localhost/dev/null"
options { timecondition: 1 }
options { timevalue_large: 0 }
options { resume_from_large: 0 }
options { maxfilesize_large: 0 }
