# Pausing once content decoding has produced output must let cw-pause buffer
# the still-encoded remainder of the response. This body is a valid gzip stream
# built from a single stored deflate block, so it stays printable while being
# larger than one 4096-byte cw-pause chunk. The response callback pauses on the
# first decoded write, leaving the rest of the compressed input to be buffered
# and replayed when the bounded event loop resumes the transfer.
scheme: SCHEME_HTTP
host_path: "api.test/pause-buffered"
options { option_id: CURLOPT_ACCEPT_ENCODING string_value: "gzip" }
connection {
  initial_response: "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 12311\r\nContent-Encoding: gzip\r\n\r\n\x1f\x8b\x08\x00\x00\x00\x00\x00\x04\x03\x01\x000\xff\\xaf4\xd7\x86\x000\x00\x00"
}
api_plan {
  pause_response_once: true
  drive_mode: API_DRIVE_MULTI_PERFORM
}
