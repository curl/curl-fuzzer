# Complete a verified TLS handshake and receive the internal DoH request, then
# close the endpoint without HTTP response bytes. curl therefore records the
# DoH probe's transport result rather than an HTTP-status or DNS-decode error.
scheme: SCHEME_HTTPS
host_path: "tls.test/doh-https-transport-error"
doh {
  response_mode: DOH_RESPONSE_MODE_TRANSPORT_ERROR
  transport_mode: DOH_TRANSPORT_HTTPS
}
trace_config: "+DOH"
http2_plan {
  actions {
    wait {
      event: HTTP2_CLIENT_EVENT_HEADERS
      stream { request_index: 0 }
      count: 1
    }
  }
}
