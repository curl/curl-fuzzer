# Return a non-success status from the owned loopback DoH endpoint so curl
# reports the transport result before attempting to decode DNS bytes.
scheme: SCHEME_HTTPS
host_path: "tls.test/doh-http-error"
doh {
  response_mode: DOH_RESPONSE_MODE_HTTP_ERROR
}
trace_config: "+DOH"
http2_plan {
  actions {
    wait {
      event: HTTP2_CLIENT_EVENT_HEADERS
      stream { request_index: 0 }
      count: 1
    }
  }
}
