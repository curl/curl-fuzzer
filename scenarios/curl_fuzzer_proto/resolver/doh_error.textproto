# Complete each loopback DoH HTTP exchange with a one-byte malformed DNS
# message. This reaches curl's typed DoH diagnostics without falling back to
# the native resolver or requiring the outer TLS request to succeed.
scheme: SCHEME_HTTPS
host_path: "tls.test/doh-error"
resolver_mode: RESOLVER_MODE_DOH_ERROR
# Verbose DoH diagnostics are routed through the harness's silent debug
# callback. This intentionally evaluates curl's typed error formatter without
# producing per-input log traffic.
trace_config: "+DOH"
http2_plan {
  actions {
    wait {
      event: HTTP2_CLIENT_EVENT_HEADERS
      stream { request_index: 0 }
      count: 1
    }
  }
  actions {
    headers {
      stream { request_index: 0 }
      status_code: 200
    }
  }
  actions {
    data {
      stream { request_index: 0 }
      data: "OK"
      end_stream: true
    }
  }
}
