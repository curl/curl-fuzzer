# Resolve an HTTPS origin through the resolver lane's loopback DoH responder.
# The synthesized HTTPS resource record carries alpn=h2,h3, so curl's
# HTTPS-connect filter selects h2 from the DNS record and completes the
# exchange through the in-process TLS/ALPN h2 peer.
# Replay with CURL_DEBUG=+HTTPS-CONNECT FUZZ_VERBOSE=1 to print the filter's
# "1st attempt uses h2 from HTTPS-RR" decision.
scheme: SCHEME_HTTPS
host_path: "tls.test/doh-httpsrr"
doh_https_rr: true
http2_plan {
  actions {
    wait {
      event: HTTP2_CLIENT_EVENT_HEADERS
      stream { request_index: 0 }
      count: 1
    }
  }
  actions {
    headers {
      stream { request_index: 0 }
      status_code: 200
    }
  }
  actions {
    data {
      stream { request_index: 0 }
      data: "OK"
      end_stream: true
    }
  }
}
