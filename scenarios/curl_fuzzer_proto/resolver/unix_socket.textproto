# Ask curl to build an AF_UNIX peer from a fixed, non-existent pathname. The
# open-socket callback ignores that pathname and returns its anonymous
# connected socketpair, so no filesystem endpoint is opened.
scheme: SCHEME_HTTP
host_path: "resolver-unix.test/unix"
resolver_mode: RESOLVER_MODE_UNIX_SOCKET
connection {
  on_readable: "HTTP/1.1 200 OK\r\nContent-Length: 4\r\nConnection: close\r\n\r\nunix"
}
