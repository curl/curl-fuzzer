# Propagate a harness-owned non-global diagnostic stream to curl-created DoH
# handles while they complete the verified HTTPS exchange.
scheme: SCHEME_HTTPS
host_path: "tls.test/doh-https-custom-stderr"
doh {
  response_mode: DOH_RESPONSE_MODE_NORMAL
  transport_mode: DOH_TRANSPORT_HTTPS
  option_probe_mode: DOH_OPTION_PROBE_CUSTOM_STDERR
}
trace_config: "+DOH"
http2_plan {
  actions {
    wait {
      event: HTTP2_CLIENT_EVENT_HEADERS
      stream { request_index: 0 }
      count: 1
    }
  }
  actions {
    headers {
      stream { request_index: 0 }
      status_code: 200
    }
  }
  actions {
    data {
      stream { request_index: 0 }
      data: "OK"
      end_stream: true
    }
  }
}
