# OPTIONS is curl's default RTSP method. The peer waits for the request before
# releasing the method list, which keeps the request/response exchange aligned
# even though RTSP has no server greeting.
scheme: SCHEME_RTSP
host_path: "rtsp.test/stream"
options { rtsp_request: 1 }
options { useragent: "curl-fuzzer-rtsp" }
connection {
  on_readable: "RTSP/1.0 200 OK\r\nCSeq: 1\r\nPublic: DESCRIBE, OPTIONS, SETUP, PLAY, PAUSE, TEARDOWN, GET_PARAMETER, SET_PARAMETER\r\n\r\n"
}
