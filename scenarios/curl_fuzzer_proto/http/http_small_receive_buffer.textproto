# The minimum useful receive buffer forces the transfer writer to cycle over
# several reads while the response remains compact enough for fast-lane use.
scheme: SCHEME_HTTP
host_path: "buffers.test/small-receive"
options { option_id: CURLOPT_BUFFERSIZE uint_value: 1024 }
connection {
  initial_response: "HTTP/1.1 200 OK\r\nContent-Length: 1744\r\n\r\n"
  on_readable: ""
}
