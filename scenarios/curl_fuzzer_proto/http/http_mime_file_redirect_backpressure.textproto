# A 307 retry after request bytes become readable forces curl's MIME file
# source to rewind through curlx_fseek before replaying it on the next socket.
scheme: SCHEME_HTTP
host_path: "upload.test/mime/source"
options { option_id: CURLOPT_FOLLOWLOCATION uint_value: 1 }
options { option_id: CURLOPT_MAXREDIRS uint_value: 2 }
request_headers: "Expect:"
mime_post {
  parts {
    name: "file"
    filename: "boundary.bin"
    content_type: "application/octet-stream"
    file_data { pattern: "F" repeat_count: 65537 }
  }
}
connection {
  backpressure { recv_buf_bytes: 2048 drain_limit: 32 }
  on_readable: "HTTP/1.1 307 Temporary Redirect\r\nLocation: http://upload.test/mime/destination\r\nConnection: close\r\nContent-Length: 0\r\n\r\n"
}
subsequent_connections {
  initial_response: "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nOK"
}
