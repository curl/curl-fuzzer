# Cross-origin redirects normally suppress credentials. Enabling unrestricted
# auth and completing the second connection exercises the deliberate
# carry-forward decision and emits Authorization at the new host; the paired
# default-policy seed covers the non-leakage branch.
scheme: SCHEME_HTTP
host_path: "auth.test/redirect"
options { option_id: CURLOPT_USERPWD string_value: "redirect:secret" }
options { option_id: CURLOPT_HTTPAUTH uint_value: 1 }
options { option_id: CURLOPT_UNRESTRICTED_AUTH bool_value: true }
options { option_id: CURLOPT_FOLLOWLOCATION uint_value: 1 }
options { option_id: CURLOPT_MAXREDIRS uint_value: 2 }
connection {
  initial_response: "HTTP/1.1 302 Found\r\nLocation: http://other-auth.test/final\r\nConnection: close\r\nContent-Length: 0\r\n\r\n"
}
subsequent_connections {
  initial_response: "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nOK"
}
