# Disable both automatic decode layers while advertising support for transfer
# codings. Ignoring the deliberately conflicting Content-Length fields lets
# the chunk parser consume a complete response and exposes framing mutations
# around all four controls without making the seed itself fail immediately.
scheme: SCHEME_HTTP
host_path: "decode.test/raw"
options { accept_encoding: "gzip" }
options { transfer_encoding: true }
options { http_transfer_decoding: false }
options { http_content_decoding: false }
options { ignore_content_length: true }
connection {
  initial_response: "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Encoding: gzip\r\nContent-Length: 999\r\nContent-Length: 5\r\n\r\n5\r\nhello\r\n0\r\nX-Trailer: done\r\n\r\n"
}
