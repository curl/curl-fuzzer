# CURLFOLLOW_FIRSTONLY drops a custom method on every redirect, including a
# 307 that would otherwise preserve the request method. Starting from the
# default GET state isolates this mode-specific PURGE-to-GET transition.
scheme: SCHEME_HTTP
host_path: "follow-mode.test/first/start"
options { option_id: CURLOPT_CUSTOMREQUEST string_value: "PURGE" }
options { option_id: CURLOPT_FOLLOWLOCATION uint_value: 3 }
options { option_id: CURLOPT_MAXREDIRS uint_value: 2 }
connection {
  initial_response: "HTTP/1.1 307 Temporary Redirect\r\nLocation: http://follow-mode.test/first/end\r\nConnection: close\r\nContent-Length: 0\r\n\r\n"
}
subsequent_connections {
  initial_response: "HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\ndone"
}
