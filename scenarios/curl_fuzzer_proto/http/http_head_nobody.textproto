# NOBODY makes curl issue HEAD and complete from headers alone. Omitting the
# advertised body is intentional: a client that waits for those bytes has
# failed to apply HEAD response semantics.
scheme: SCHEME_HTTP
host_path: "127.0.0.1/head"
options { option_id: CURLOPT_NOBODY bool_value: true }
connection {
  initial_response: "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 1234\r\nAccept-Ranges: bytes\r\n\r\n"
}
