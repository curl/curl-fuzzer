# CURLFOLLOW_OBEYCODE is distinct from the historical boolean mode: a custom
# method is honoured initially, but a 302's POST-to-GET rule must suppress it
# on the follow-up request. The paired socket lets that GET finish normally.
scheme: SCHEME_HTTP
host_path: "follow-mode.test/obey/start"
options { option_id: CURLOPT_POST bool_value: true }
options { option_id: CURLOPT_POSTFIELDS string_value: "mode=obeycode" }
options { option_id: CURLOPT_CUSTOMREQUEST string_value: "PATCH" }
options { option_id: CURLOPT_FOLLOWLOCATION uint_value: 2 }
options { option_id: CURLOPT_MAXREDIRS uint_value: 2 }
connection {
  initial_response: "HTTP/1.1 302 Found\r\nLocation: http://follow-mode.test/obey/end\r\nConnection: close\r\nContent-Length: 0\r\n\r\n"
}
subsequent_connections {
  initial_response: "HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\ndone"
}
