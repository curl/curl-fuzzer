# Header-only seed for curl's request header lookup, suppression, empty-value,
# connection-token, cookie, range, and Expect parsing. Keeping this separate
# from MIME means those parsers remain reachable through a cheap GET mutation.
scheme: SCHEME_HTTP
host_path: "127.0.0.1/custom-headers"
request_headers: "Expect:"
request_headers: "X-Empty;"
request_headers: "Connection: keep-alive, X-Hop"
request_headers: "X-Hop: remove-me"
request_headers: "Cookie: a=1; quoted=\"two three\""
request_headers: "Range: bytes=0-3"
request_headers: "Accept-Encoding: gzip, zstd"
connection {
  initial_response: "HTTP/1.1 206 Partial Content\r\nContent-Range: bytes 0-3/8\r\nContent-Length: 4\r\nConnection: close\r\n\r\npart"
}
