# A syntactically useful byte range enters curl's request range builder and
# gives its 206 validator a matching Content-Range instead of stopping at the
# much shallower malformed-range paths mutations find on their own.
scheme: SCHEME_HTTP
host_path: "range.test/object"
options { option_id: CURLOPT_RANGE string_value: "5-11" }
connection {
  initial_response: "HTTP/1.1 206 Partial Content\r\nContent-Range: bytes 5-11/20\r\nContent-Length: 7\r\n\r\npartial"
}
