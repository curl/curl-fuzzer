# A completed 307 retry couples the seek callback to real redirect state.
# One-byte reads make curl revisit its client-reader path before the first
# response, while SEEK_OK lets the second socket replay exactly the same body.
scheme: SCHEME_HTTP
host_path: "upload.test/redirect/source"
options { upload: true }
options { customrequest: "POST" }
options { infilesize_large: 13 }
options { followlocation: 1 }
options { maxredirs: 2 }
request_headers: "Expect:"
upload {
  data: "redirect-body"
  read_sizes: 1
  read_sizes: 2
  read_sizes: 3
  terminal: UPLOAD_TERMINAL_EOF
  seek_result: UPLOAD_SEEK_OK
}
connection {
  on_readable: "HTTP/1.1 307 Temporary Redirect\r\nLocation: http://upload.test/redirect/destination\r\nConnection: close\r\nContent-Length: 0\r\n\r\n"
}
subsequent_connections {
  initial_response: "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nOK"
}
