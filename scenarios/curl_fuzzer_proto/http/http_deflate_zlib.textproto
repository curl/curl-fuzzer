# RFC-style zlib-wrapped DEFLATE. curl's deflate decoder starts in zlib mode;
# this complements the raw-stream seed so both initialization paths survive
# corpus minimization independently.
scheme: SCHEME_HTTP
host_path: "127.0.0.1/deflate-zlib"
options { option_id: CURLOPT_ACCEPT_ENCODING string_value: "" }
connection {
  initial_response: "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Encoding: deflate\r\nContent-Length: 57\r\n\r\n\x78\x9c\x4b\x2e\x2d\xca\x51\x48\x49\x4d\xcb\x49\x2c\x49\x55\x48\xce\x2f\x4b\x2d\x4a\x4c\x4f\xb5\x52\xa8\xca\xc9\x4c\x52\x28\x2f\x4a\x2c\x28\x48\x2d\x52\x48\xcc\x4b\x51\x48\xce\x48\x4d\xce\x2e\x2e\xcd\xe5\x02\x00\xca\x97\x12\x14"
}
