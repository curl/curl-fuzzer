# Keep each quoted-string input below digest.c's independent 2048-byte
# escape limit, but make their combined Authorization value exceed its
# 4096-byte response buffer.
scheme: SCHEME_HTTP
host_path: "auth."
options { userpwd: ":p" }
options { httpauth: 2 }
connection {
  initial_response: "HTTP/1.1 401 Unauthorized\r\nWWW-Authenticate: Digest realm=\"r\", qop=\"auth\", algorithm=MD5, nonce=\"n\"\r\nConnection: close\r\nContent-Length: 0\r\n\r\n"
}
subsequent_connections {
  initial_response: "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n"
}
