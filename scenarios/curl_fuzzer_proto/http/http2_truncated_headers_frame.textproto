# HTTP/2 prior knowledge with a syntactically framed but truncated HEADERS
# payload. The frame advertises eight payload bytes, supplies only the indexed
# HPACK :status=200 byte, and then reaches EOF. This is the structured analogue
# of the legacy test_invalid_prior_http2 error-path seed.
scheme: SCHEME_HTTP
host_path: "127.0.0.1/http2-truncated"
options { option_id: CURLOPT_HTTP_VERSION uint_value: 5 }
connection {
  initial_response: "\x00\x00\x00\x04\x00\x00\x00\x00\x00"
  on_readable: "\x00\x00\x00\x04\x01\x00\x00\x00\x00\x00\x00\x08\x01\x04\x00\x00\x00\x01\x88"
}
