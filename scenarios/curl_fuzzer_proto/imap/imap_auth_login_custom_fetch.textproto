# Exercise SASL LOGIN's two continuation payloads before a custom UID FETCH
# listing. The tag-relative replies keep the seed independent of curl's
# process-global IMAP command id while the transcript regression pins the
# complete public exchange.
scheme: SCHEME_IMAP
host_path: "imap.test/INBOX"
options { option_id: CURLOPT_USERNAME string_value: "fuzz" }
options { option_id: CURLOPT_PASSWORD string_value: "secret" }
options { option_id: CURLOPT_LOGIN_OPTIONS string_value: "AUTH=LOGIN" }
options { option_id: CURLOPT_CUSTOMREQUEST string_value: "UID FETCH 1:* (FLAGS)" }
connection {
  initial_response: "* OK imap.test ready\r\n"
  on_readable: "* CAPABILITY IMAP4rev1 AUTH=LOGIN\r\nOK CAPABILITY completed\r\n"
  on_readable: "+ VXNlcm5hbWU6\r\n"
  on_readable: "+ UGFzc3dvcmQ6\r\n"
  on_readable: "OK AUTHENTICATE completed\r\n"
  on_readable: "* 1 EXISTS\r\nOK [UIDVALIDITY 7] SELECT completed\r\n"
  on_readable: "* 1 FETCH (FLAGS (\\Seen))\r\nOK FETCH completed\r\n"
}
