# Authored successor (not a byte-for-byte conversion) to the former legacy
# XOAUTH2 seed. Keep the fixed command tags paired with the transcript
# regression: they pin the audited curl command sequence.
scheme: SCHEME_IMAP
host_path: "imap.test/INBOX/;MAILINDEX=1"
options { username: "fuzz-user" }
options { login_options: "AUTH=XOAUTH2" }
options { xoauth2_bearer: "fuzz-xoauth2-token" }
connection {
  initial_response: "* OK IMAP4rev1 ready\r\n"
  on_readable: "* CAPABILITY IMAP4rev1 AUTH=XOAUTH2\r\nA001 OK CAPABILITY completed\r\n"
  on_readable: "+ \r\n"
  on_readable: "A002 OK AUTHENTICATE completed\r\n"
  on_readable: "* 1 EXISTS\r\nA003 OK [READ-WRITE] SELECT completed\r\n"
  on_readable: "* 1 FETCH (BODY[TEXT] {5}\r\nhello)\r\nA004 OK FETCH completed\r\n"
}
