# Callback-backed IMAP APPEND. After the + continuation the peer drains exactly
# the announced literal size and pre-queues the following tagged completion,
# because curl waits for it in imap_done() before the outer loop can run again.
scheme: SCHEME_IMAP
host_path: "imap.test/INBOX"
options { upload: true }
options { infilesize_large: 17 }
options { username: "fuzz" }
options { password: "secret" }
upload {
  data: "Hello from IMAP\r\n"
  read_sizes: 5
  read_sizes: 7
  read_sizes: 5
}
connection {
  initial_response: "* OK imap.test ready\r\n"
  on_readable: "* CAPABILITY IMAP4rev1\r\nOK CAPABILITY completed\r\n"
  on_readable: "OK LOGIN completed\r\n"
  on_readable: "+ Ready for literal\r\n"
  on_readable: "OK APPEND completed\r\n"
}
