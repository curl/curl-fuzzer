# A receive-buffer-only pressure setup makes this long SELECT command
# short-write before the immediate-service peer drains it. The tagged denial
# proves the complete mailbox reached the server.
scheme: SCHEME_IMAP
host_path: "imap."
options { username: "fuzz" }
options { password: "secret" }
options { customrequest: "NOOP" }
connection {
  initial_response: "* OK imap.test ready\r\n"
  on_readable: "* CAPABILITY IMAP4rev1\r\nOK CAPABILITY completed\r\n"
  on_readable: "OK LOGIN completed\r\n"
  on_readable: "NO mailbox unavailable\r\n"
  backpressure { recv_buf_bytes: 2048 }
}
