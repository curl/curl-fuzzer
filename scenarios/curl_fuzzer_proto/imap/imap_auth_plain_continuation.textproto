# AUTH PLAIN without SASL-IR. The first continuation carries an authorization
# identity, username, and password; the preserved command tag must then finish
# authentication before SELECT and FETCH can proceed.
scheme: SCHEME_IMAP
host_path: "imap.test/INBOX;UID=1"
options { option_id: CURLOPT_USERNAME string_value: "fuzz" }
options { option_id: CURLOPT_PASSWORD string_value: "secret" }
options { option_id: CURLOPT_LOGIN_OPTIONS string_value: "AUTH=PLAIN" }
options { option_id: CURLOPT_SASL_AUTHZID string_value: "authorization-id" }
connection {
  initial_response: "* OK imap.test ready\r\n"
  on_readable: "* CAPABILITY IMAP4rev1 AUTH=PLAIN\r\nOK CAPABILITY completed\r\n"
  on_readable: "* OK authentication continues\r\n+ \r\n"
  on_readable: "OK AUTHENTICATE completed\r\n"
  on_readable: "* 1 EXISTS\r\nOK [UIDVALIDITY 7] SELECT completed\r\n"
  on_readable: "* 1 FETCH (BODY[] {17}\r\nHello from IMAP\r\nOK FETCH completed\r\n"
}
