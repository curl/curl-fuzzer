# Exercise the fuzzer-controlled curl_global_trace() lane. The silent debug
# callback keeps curl_trc.c's per-feature formatting reachable while the
# multi runner drives several handles through the same trace configuration.
scheme: SCHEME_HTTP
host_path: "multi.test/trace-config"
connection {
  initial_response: "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok"
}
trace_config: "all"
multi_plan {
  transfer_count: 2
  max_host_connections: 2
  max_total_connections: 2
  connection_cache_size: 2
}
