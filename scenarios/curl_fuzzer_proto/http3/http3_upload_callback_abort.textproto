# Cancel a callback upload after two of the advertised four bytes. The peer
# can consume curl's final stream-reset traffic after the client completes.
scheme: SCHEME_HTTPS
host_path: "tls.test/upload/callback-abort"
options { upload: true }
options { infilesize_large: 4 }
request_headers: "Expect:"
upload {
  data: "ab"
  read_sizes: 1
  terminal: UPLOAD_TERMINAL_ABORT
}
http3_plan {
  actions {
    structured_response {
      status_code: 200
      finish_stream: true
    }
  }
}
