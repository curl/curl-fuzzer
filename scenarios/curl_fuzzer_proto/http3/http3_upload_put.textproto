# A short callback upload completes both sides of an ordinary request stream.
scheme: SCHEME_HTTPS
host_path: "tls.test/upload/put"
options { upload: true }
options { infilesize_large: 4 }
request_headers: "Expect:"
upload {
  data: "data"
  read_sizes: 2
  terminal: UPLOAD_TERMINAL_EOF
}
http3_plan {
  actions {
    structured_response {
      status_code: 200
      finish_stream: true
    }
  }
}
