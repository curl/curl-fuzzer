# Complete MQTT publish exchange. curl sends CONNECT, accepts the preloaded
# CONNACK, publishes the URL path as its topic with CURLOPT_POSTFIELDS as the
# payload, then sends DISCONNECT and finishes without reading another packet.
# Current curl hardcodes fixed-header flags 0x30 (QoS 0); the peer still answers
# a QoS 1 PUBLISH with PUBACK if a future revision sets those flags.
scheme: SCHEME_MQTT
host_path: "mqtt.test/sensors/kitchen"
probe_multi_pollset: true
options { postfields: "hello mqtt" }
options { username: "fuzz" }
options { password: "secret" }
connection {
  # CONNACK: 0x20, remaining length 2, session-present 0, return code 0.
  initial_response: "\040\002\000\000"
}
