# A CONNACK with a non-zero return code must reject the connection before curl
# sends any PUBLISH or SUBSCRIBE packet.
scheme: SCHEME_MQTT
host_path: "mqtt.test/sensors/rejected"
options { postfields: "never sent" }
connection {
  # CONNACK: 0x20, remaining length 2, session-present 0, return code 5.
  initial_response: "\040\002\000\005"
}
