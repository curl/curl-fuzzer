# Complete implicit-TLS MQTTS publish exchange. curl negotiates TLS immediately,
# then sends CONNECT, accepts the preloaded CONNACK, publishes the URL path as
# its topic with CURLOPT_POSTFIELDS as the payload, sends DISCONNECT, and
# finishes without reading another packet.
scheme: SCHEME_MQTTS
host_path: "tls.test/sensors/kitchen"
probe_multi_pollset: true
options { postfields: "hello mqtt" }
options { username: "fuzz" }
options { password: "secret" }
connection {
  # CONNACK: 0x20, remaining length 2, session-present 0, return code 0.
  initial_response: "\040\002\000\000"
}
