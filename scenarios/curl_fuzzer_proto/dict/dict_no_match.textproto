# DICT lookup that finds no match. The server still terminates the response
# with the RFC 2229 dot line; the credentials exercise DICT's authentication
# option handling even though this server never challenges them.
scheme: SCHEME_DICT
host_path: "dict.test/d:missing"
options { username: "fuzz" }
options { password: "secret" }
connection {
  on_readable: "552 no match\r\n.\r\n"
}
