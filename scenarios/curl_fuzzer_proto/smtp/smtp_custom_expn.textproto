# With a recipient but no upload, CURLOPT_CUSTOMREQUEST selects a command path
# such as EXPN instead of the mail-envelope state machine.
scheme: SCHEME_SMTP
host_path: "smtp.test/command.test"
options { customrequest: "EXPN" }
mail_rcpt: "list@example.test"
connection {
  initial_response: "220 smtp.test ESMTP fuzz peer\r\n"
  on_readable: "250 smtp.test\r\n"
  on_readable: "250 member@example.test\r\n"
  on_readable: "221 bye\r\n"
}
