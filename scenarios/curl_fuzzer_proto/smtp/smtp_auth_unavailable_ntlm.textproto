# The curl-fuzzer build explicitly disables NTLM. Advertising only that
# selected mechanism reaches the blocked/unchosen SASL path without sending an
# AUTH command.
scheme: SCHEME_SMTP
host_path: "smtp.test/unavailable.test"
options { username: "fuzz" }
options { password: "secret" }
options { login_options: "AUTH=NTLM" }
connection {
  initial_response: "220 smtp.test ESMTP fuzz peer\r\n"
  on_readable: "250-smtp.test\r\n250-AUTH NTLM\r\n250 8BITMIME\r\n"
}
