# Exercise verified WSS framing with the alternate certificate chain and make
# curl materialize every peer certificate through CURLINFO_CERTINFO.
scheme: SCHEME_WSS
host_path: "tls.test/certinfo-all-key-types"
tls_certificate_chain: TLS_CERTIFICATE_CHAIN_ALL_KEY_TYPES
options { ssl_verifypeer: true }
options { ssl_verifyhost: 2 }
options { certinfo: true }
connection {
  server_frames {
    fin: true
    opcode: 1
    payload: "secure-websocket"
  }
}
