# Leave curl's MultiSSL wrapper active through global initialization so its
# configured mbedTLS default is selected by multissl_init.
multi_ssl_backend: MULTI_SSL_BACKEND_DEFAULT
host_path: "tls.test/multissl-default"
options { ssl_verifypeer: true }
options { ssl_verifyhost: 2 }
connection {
  initial_response: "HTTP/1.1 200 OK\r\nContent-Length: 7\r\n\r\ndefault"
}
