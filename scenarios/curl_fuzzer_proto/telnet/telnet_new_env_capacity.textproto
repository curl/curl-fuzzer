# Three individually bounded environment entries exceed curl's fixed 2048-byte
# reply buffer. The first two are serialized and the third is skipped, covering
# capacity handling without making the client write more than one small reply.
scheme: SCHEME_TELNET
host_path: "127.0.0.1/"
telnet_options: "NEW_ENV=A,"
telnet_options: "NEW_ENV=B,"
telnet_options: "NEW_ENV=C,"
connection { initial_response: "\xff\xfa\x27\x01\xff\xf0" }
