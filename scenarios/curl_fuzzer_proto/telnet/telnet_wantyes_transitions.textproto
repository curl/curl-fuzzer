# curl reads TELNET in 4096-byte blocks. The first block provokes negotiation
# and ends exactly at that boundary. Replies in the second block first settle
# WANTYES, then repeat and disable BINARY to exercise the corresponding YES
# states; SGA is rejected while its request is still pending.
scheme: SCHEME_TELNET
host_path: "127.0.0.1/"
connection {
  initial_response: "\377\373\"
  on_readable: "\xff\xfb\x00\xff\xfb\x00\xff\xfc\x00\xff\xfd\x00\xff\xfd\x00\xff\xfe\x00\xff\xfc\x03\xff\xfe\x03"
}
