# Fill exactly one 4096-byte recv so curl performs its initial negotiation
# before reading DO NAWS. That reply observes WANTYES and exercises the
# post-negotiation NAWS suboption path with only two IAC markers in total.
scheme: SCHEME_TELNET
host_path: "127.0.0.1/"
telnet_options: "WS=80x24"
connection {
  initial_response: "\xff\xfb\"
  on_readable: "\xff\xfd\x1f"
}
