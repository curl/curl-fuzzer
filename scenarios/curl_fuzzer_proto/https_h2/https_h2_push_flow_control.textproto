# Hold the parent's request body behind a zero stream window while an accepted
# push completes. Releasing the request stream afterward makes WINDOW_UPDATE
# ordering interact with two live HTTP/2 easy handles instead of an idle
# connection.
scheme: SCHEME_HTTPS
host_path: "tls.test/h2-push-flow"
accept_h2_push: true
options { option_id: CURLOPT_POST bool_value: true }
options { option_id: CURLOPT_POSTFIELDS string_value: "queued-body" }
http2_plan {
  # SETTINGS_INITIAL_WINDOW_SIZE=0 blocks DATA, but not request HEADERS.
  initial_settings {
    entries {
      identifier: 4
      value: 0
    }
  }
  actions {
    wait {
      event: HTTP2_CLIENT_EVENT_HEADERS
      stream { request_index: 0 }
      count: 1
    }
  }
  # Promise and open the first pushed stream while the parent's POST DATA
  # remains queued.
  actions {
    push_promise {
      parent_stream { request_index: 0 }
      promised_stream { push_index: 0 }
    }
  }
  actions {
    headers {
      stream { push_index: 0 }
      status_code: 200
    }
  }
  # Release the pending request body while both response streams remain live.
  actions {
    window_update {
      stream { request_index: 0 }
      increment: 65535
    }
  }
  actions {
    data {
      stream { push_index: 0 }
      data: "pushed"
      end_stream: true
    }
  }
  actions {
    headers {
      stream { request_index: 0 }
      status_code: 200
    }
  }
  actions {
    data {
      stream { request_index: 0 }
      data: "OK"
      end_stream: true
    }
  }
}
