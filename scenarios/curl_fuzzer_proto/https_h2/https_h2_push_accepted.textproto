# Accept one promised stream and complete it while the parent response remains
# open. The two response bodies use separate easy-handle callbacks, so this
# exercises curl's pushed-handle setup, multiplexed delivery, and teardown.
scheme: SCHEME_HTTPS
host_path: "tls.test/h2-push-accepted"
accept_h2_push: true
http2_plan {
  actions {
    wait {
      event: HTTP2_CLIENT_EVENT_HEADERS
      stream { request_index: 0 }
      count: 1
    }
  }
  # PUSH_PROMISE(first request -> first promised stream): GET /push.
  actions {
    push_promise {
      parent_stream { request_index: 0 }
      promised_stream { push_index: 0 }
    }
  }
  # Open the parent response, then complete the promised stream before it.
  actions {
    headers {
      stream { request_index: 0 }
      status_code: 200
    }
  }
  actions {
    headers {
      stream { push_index: 0 }
      status_code: 200
    }
  }
  actions {
    data {
      stream { push_index: 0 }
      data: "pushed"
      end_stream: true
    }
  }
  actions {
    data {
      stream { request_index: 0 }
      data: "OK"
      end_stream: true
    }
  }
}
