# Reset an accepted pushed response, then send a graceful GOAWAY while its
# parent stream is still active. The first request remains permitted by
# last_stream_id and completes after both control transitions.
scheme: SCHEME_HTTPS
host_path: "tls.test/h2-push-reset"
accept_h2_push: true
http2_plan {
  actions {
    wait {
      event: HTTP2_CLIENT_EVENT_HEADERS
      stream { request_index: 0 }
      count: 1
    }
  }
  # Promise the first pushed stream, then begin its 200 response.
  actions {
    push_promise {
      parent_stream { request_index: 0 }
      promised_stream { push_index: 0 }
    }
  }
  actions {
    headers {
      stream { push_index: 0 }
      status_code: 200
    }
  }
  # RST_STREAM(first pushed stream, CANCEL).
  actions {
    rst_stream {
      stream { push_index: 0 }
      error_code: 8
    }
  }
  # GOAWAY(first request, NO_ERROR), followed by parent completion.
  actions {
    goaway {
      last_stream { request_index: 0 }
      error_code: 0
    }
  }
  actions {
    headers {
      stream { request_index: 0 }
      status_code: 200
    }
  }
  actions {
    data {
      stream { request_index: 0 }
      data: "OK"
      end_stream: true
    }
  }
}
