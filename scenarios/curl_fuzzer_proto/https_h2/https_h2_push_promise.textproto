# A verified TLS/ALPN h2 exchange with one valid server push offer. The fixed
# lane installs CURLMOPT_PUSHFUNCTION before curl sends its SETTINGS, so the
# PUSH_PROMISE reaches the application callback. The callback inspects the
# public push-header accessors and rejects the promised stream, keeping
# ownership bounded.
scheme: SCHEME_HTTPS
host_path: "tls.test/h2-push"
http2_plan {
  # Wait for curl's request HEADERS so every following action uses the
  # observed client-assigned stream rather than a literal stream ID.
  actions {
    wait {
      event: HTTP2_CLIENT_EVENT_HEADERS
      stream { request_index: 0 }
      count: 1
    }
  }
  # Promise the first server stream from the first observed request. The peer
  # supplies the GET, https, authority, and /push pseudo-headers through HPACK.
  actions {
    push_promise {
      parent_stream { request_index: 0 }
      promised_stream { push_index: 0 }
    }
  }
  # Complete the parent with :status=200 and END_STREAM DATA.
  actions {
    headers {
      stream { request_index: 0 }
      status_code: 200
    }
  }
  actions {
    data {
      stream { request_index: 0 }
      data: "OK"
      end_stream: true
    }
  }
}
