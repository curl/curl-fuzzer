# Follow a relative redirect over the same HTTP/2 TLS connection. The first
# request redirects to /reuse, a server PING exercises automatic ACK
# generation, and the second request completes on the reused connection. The
# fixed peer also calls curl_easy_upkeep once with a zero interval after
# completion, producing a bounded client-origin PING without sleeping.
scheme: SCHEME_HTTPS
host_path: "tls.test/h2-start"
options { option_id: CURLOPT_FOLLOWLOCATION uint_value: 1 }
options { option_id: CURLOPT_MAXREDIRS uint_value: 2 }
http2_plan {
  actions {
    wait {
      event: HTTP2_CLIENT_EVENT_HEADERS
      stream { request_index: 0 }
      count: 1
    }
  }
  # Finish the first response with :status=302 and location: /reuse.
  actions {
    headers {
      stream { request_index: 0 }
      status_code: 302
      fields { name: "location" value: "/reuse" }
      end_stream: true
    }
  }
  # Server-origin PING. Curl must ACK it while scheduling the redirected GET.
  actions { ping { opaque_data: "h2-reuse" } }
  actions {
    wait {
      event: HTTP2_CLIENT_EVENT_HEADERS
      stream { request_index: 1 }
      count: 1
    }
  }
  # Complete the second response with :status=200 and content-type.
  actions {
    headers {
      stream { request_index: 1 }
      status_code: 200
      fields { name: "content-type" value: "text/plain" }
    }
  }
  actions {
    data {
      stream { request_index: 1 }
      data: "reused"
      end_stream: true
    }
  }
}
