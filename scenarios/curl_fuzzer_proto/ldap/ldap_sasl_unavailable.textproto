# Ask for a mechanism the bounded peer does not advertise. Discovery must
# finish with CURLE_LOGIN_DENIED without sending a bind or starting a data
# search.
scheme: SCHEME_LDAP
host_path: "ldap.test/dc=example,dc=com?cn?sub?(objectclass=*)"
options { username: "cn=admin,dc=example,dc=com" }
options { password: "secret" }
options { login_options: "AUTH=LOGIN" }
