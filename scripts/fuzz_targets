#!/usr/bin/env bash

FUZZ_TARGETS_LIST="curl_fuzzer_ftp curl_fuzzer_mqtt curl_fuzzer_rtsp curl_fuzzer_smtp curl_fuzzer_tftp curl_fuzzer fuzz_url fuzz_bufq fuzz_doh fuzz_netrc"

# This helper deliberately terminates immediately outside profiling builds, so
# exposing it to ordinary libFuzzer smoke checks makes it look like a broken
# target. Coverage and Introspector builds execute its deterministic probes.
case "${SANITIZER:-}" in
    coverage|introspector)
        FUZZ_TARGETS_LIST="${FUZZ_TARGETS_LIST} curl_fuzzer_full_coverage"
        ;;
esac

# OSS-Fuzz supports i386 with AddressSanitizer. The base structured suite uses
# the same OpenSSL dependency stack that is already available in that build.
if [ "${ARCHITECTURE:-}" != "i386" ] || [ "${SANITIZER:-}" = "address" ]; then
    FUZZ_TARGETS_LIST="${FUZZ_TARGETS_LIST} curl_fuzzer_proto curl_fuzzer_proto_http curl_fuzzer_proto_http_deep curl_fuzzer_proto_http2 curl_fuzzer_proto_https curl_fuzzer_proto_https_h2 curl_fuzzer_proto_h2_proxy curl_fuzzer_proto_socks4 curl_fuzzer_proto_resolver curl_fuzzer_proto_ws curl_fuzzer_proto_wss curl_fuzzer_proto_telnet curl_fuzzer_proto_ftp curl_fuzzer_proto_tftp curl_fuzzer_proto_smtp curl_fuzzer_proto_imap curl_fuzzer_proto_pop3 curl_fuzzer_proto_mqtt curl_fuzzer_proto_dict curl_fuzzer_proto_file curl_fuzzer_proto_ldap curl_fuzzer_proto_rtsp curl_fuzzer_proto_ipfs curl_fuzzer_proto_gopher curl_fuzzer_proto_api curl_fuzzer_proto_multi curl_fuzzer_proto_timing"
fi

# The alternative TLS and HTTP/3 dependency stacks are intentionally omitted
# from i386 and MemorySanitizer builds until their static dependencies have
# been validated for those configurations.
if [ "${ARCHITECTURE:-}" != "i386" ] && [ "${SANITIZER:-}" != "memory" ]; then
    FUZZ_TARGETS_LIST="${FUZZ_TARGETS_LIST} curl_fuzzer_proto_https_gnutls curl_fuzzer_proto_https_mbedtls curl_fuzzer_proto_http3"
fi

# A caller may narrow an OSS-Fuzz build to one supported executable. Apply the
# architecture and sanitizer gates first so unavailable variants are rejected.
if [[ -n "${CURL_FUZZ_TARGET:-}" ]]; then
    if [[ "${CURL_FUZZ_TARGET}" == *[[:space:]]* ]]; then
        echo "CURL_FUZZ_TARGET must name exactly one target" >&2
        return 1
    fi
    if [[ " ${FUZZ_TARGETS_LIST} " != *" ${CURL_FUZZ_TARGET} "* ]]; then
        echo "Unknown or unsupported CURL_FUZZ_TARGET: ${CURL_FUZZ_TARGET}" >&2
        return 1
    fi
    FUZZ_TARGETS_LIST="${CURL_FUZZ_TARGET}"
fi

export FUZZ_TARGETS="${FUZZ_TARGETS_LIST}"
